{
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "install:all": "npm install && for d in extensions/*/; do [ -f \"$d/package.json\" ] && npm --prefix \"$d\" install; done",
    "test": "for d in extensions/*/; do [ -f \"$d/package.json\" ] && npm --prefix \"$d\" test --if-present; done",
    "test:live": "npm --prefix extensions/subagents run test:live"
  }
}
