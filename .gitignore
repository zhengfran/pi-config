# Dependencies
node_modules/

# Downloaded/generated executables (file-search fallback binaries)
bin/

# Pi runtime and private state
sessions/
run-history.jsonl
auth.json
trust.json
models.json
models-store.json
npm/
git/

# settings.json is tracked here on purpose: this directory IS the dotfiles
# copy of ~/.pi/agent, so the settings are config, not runtime state.
!settings.json

# Environment variables and secrets
.env
.env.*
*.pem
*.key

# Logs and temporary files
*.log
*.tmp
*.swp
.DS_Store

# Local editor settings
.vscode/
.idea/
